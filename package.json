{
  "name": "dsh-deepseek-chat",
  "version": "0.2.0",
  "description": "Ask DeepSeek — a floating chat window for DeepSeek Harness (dsh) Web UI. Draggable, resizable 4:3 dialog, select-to-quote from the main conversation, DeepSeek V4 Flash / Pro, powered by the API key you already configured in dsh.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "chat",
    "floating-window",
    "quote"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lhenlihai-hub/dsh-deepseek-chat.git"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  }
}
